if(NOT DEFINED NEXTBUILD OR NOT DEFINED TEST_ROOT OR NOT DEFINED CLANG)
    message(FATAL_ERROR "NEXTBUILD, TEST_ROOT and CLANG are required")
endif()

function(run)
    execute_process(COMMAND "${NEXTBUILD}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "nextbuild ${ARGN} failed (${status})\n${output}\n${errors}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

file(MAKE_DIRECTORY "${TEST_ROOT}/provider/src" "${TEST_ROOT}/consumer/src" "${TEST_ROOT}/flat/src")
file(REMOVE "${TEST_ROOT}/compile_commands.json")
set(compiler "SetCompiler : '${CLANG}'")
file(WRITE "${TEST_ROOT}/provider/.nextbuild"
    "Project : Provider\nSetLibraryKind : host\nSetStandard : c++23\n${compiler}\nSetSource : @PROJECT_ROOT / provider / src\n")
file(WRITE "${TEST_ROOT}/provider/.nextbuild-dependency"
    "Dependency : Provider\nRequireProject : @PROJECT_ROOT / provider\nAddModulePath : @DEP_PCM\nLinkLibrary : @DEP_LIBRARY\n")
file(WRITE "${TEST_ROOT}/provider/src/value.cppm" "export module value;\nexport import :part;\n")
file(WRITE "${TEST_ROOT}/provider/src/part.cppm" "export module value:part;\nexport int answer() { return 42; }\n")
file(WRITE "${TEST_ROOT}/consumer/.nextbuild"
    "Project : Consumer\nSetStandard : c++23\n${compiler}\nSetSource : @PROJECT_ROOT / consumer / src\nUseDependency : @PROJECT_ROOT / provider / '.nextbuild-dependency'\n")
file(WRITE "${TEST_ROOT}/consumer/src/local header.hpp" "#define EXPECTED 42\n")
file(WRITE "${TEST_ROOT}/consumer/src/main.cpp" "#include \"local header.hpp\"\nimport value;\nint main() { return answer() == EXPECTED ? 0 : 1; }\n")
file(WRITE "${TEST_ROOT}/flat/.nextbuild"
    "Project : Flat\n${compiler}\nSetSource : @PROJECT_ROOT / flat / src\nSetExecutableLayout : {\n - start = 0x10000\n}\n")
file(WRITE "${TEST_ROOT}/flat/src/start.cpp"
    "extern \"C\" [[gnu::section(\".start\")]] void start() {}\n")
run(--root "${TEST_ROOT}" --list)
if(NOT last_output MATCHES "consumer.*flat.*provider")
    message(FATAL_ERROR "Unexpected projects: ${last_output}")
endif()
run(--root "${TEST_ROOT}" --clean)
run(--root "${TEST_ROOT}" consumer)
execute_process(COMMAND "${TEST_ROOT}/.build/consumer/consumer${EXE_SUFFIX}" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native consumer failed (${status})")
endif()
run(--root "${TEST_ROOT}" consumer)
if(NOT last_output MATCHES "0 compiled, 3 cached" OR NOT last_output MATCHES "0 compiled, 1 cached")
    message(FATAL_ERROR "Expected cached module and consumer objects: ${last_output}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
file(WRITE "${TEST_ROOT}/consumer/src/local header.hpp" "#define EXPECTED (40 + 2)\n")
run(--root "${TEST_ROOT}" consumer)
if(NOT last_output MATCHES "1 compiled, 0 cached")
    message(FATAL_ERROR "Editing a header should rebuild the consumer: ${last_output}")
endif()
file(READ "${TEST_ROOT}/compile_commands.json" commands)
string(JSON count LENGTH "${commands}")
if(NOT count EQUAL 4)
    message(FATAL_ERROR "Expected four compile database entries")
endif()
run(--root "${TEST_ROOT}" flat)
file(READ "${TEST_ROOT}/.build/flat/flat.nxflat" header LIMIT 16 HEX)
if(NOT header STREQUAL "4e58464c01000000010000002f000000")
    message(FATAL_ERROR "Unexpected NXFL header: ${header}")
endif()
file(READ "${TEST_ROOT}/.build/flat/flat.labels.json" labels)
string(JSON address GET "${labels}" labels 0 address_int)
if(NOT address EQUAL 65536)
    message(FATAL_ERROR "Unexpected NXFL label address: ${address}")
endif()
run(--root "${TEST_ROOT}" --clean)
if(EXISTS "${TEST_ROOT}/.build/consumer" OR EXISTS "${TEST_ROOT}/.build/provider" OR EXISTS "${TEST_ROOT}/.build/flat")
    message(FATAL_ERROR "Project artifacts survived --clean")
endif()
